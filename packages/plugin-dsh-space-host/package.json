{
  "name": "@vectorai/plugin-dsh-space-host",
  "version": "0.1.0-alpha.0",
  "description": "DeepSeek Harness host adapter for VectorAI two-dimensional spaces",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./src/typert.ts",
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "lib/index.js",
    "lib/typert.js",
    "lib/vectorai_vectorizer.py",
    "src/**/*.ts"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.8",
    "@vectorai/drawing-core": "workspace:*",
    "@vectorai/drawing-edit-core": "workspace:*",
    "@vectorai/drawing-edit-protocol": "workspace:*",
    "@vectorai/drawing-spatial": "workspace:*",
    "@vectorai/plugin-space-contracts": "workspace:*",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  }
}
