{
  "name": "@vectorai/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "dev": "pnpm build && electron .",
    "pack": "electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "~5.8.3",
    "vitest": "^3.0.0"
  }
}
