{
  "name": "@vectorai/plugin-dsh-annotation-host",
  "version": "0.1.0-alpha.0",
  "description": "Engineering annotation DSH host built on the VectorAI 2D semantic edit layer",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./src/typert.ts",
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/typert.js",
    "src/**/*.ts"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@node-projects/acad-ts": "3.0.2",
    "@vectorai/drawing-core": "workspace:*",
    "@vectorai/engineering-annotation": "workspace:*",
    "@vectorai/plugin-space-contracts": "workspace:*",
    "officeparser": "7.8.0"
  }
}
