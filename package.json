{
  "name": "vectorai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8.14.3",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dsh-space": "node scripts/build-dsh-space.mjs space",
    "build:dsh-annotation": "node scripts/build-dsh-space.mjs annotation",
    "sync:dsh-runtime-baseline": "node scripts/sync-dsh-runtime-baseline.mjs",
    "check:dsh-runtime-baseline": "node scripts/sync-dsh-runtime-baseline.mjs --check",
    "check:dsh-registry-readiness": "node scripts/check-dsh-registry-readiness.mjs",
    "check:dsh-source-runtime": "node scripts/check-dsh-source-runtime.mjs",
    "check:dsh-build-freshness": "node scripts/check-dsh-build-freshness.mjs all",
    "probe:dsh-recognition": "node scripts/probe-dsh-recognition-runtime.mjs",
    "pack:dsh-plugins": "node scripts/prepare-dsh-plugin-release.mjs",
    "publish:dsh-plugins": "node scripts/publish-dsh-plugins.mjs",
    "release:dsh-plugins": "node scripts/release-dsh-plugins.mjs",
    "runtime:pack": "node scripts/build-vectorizer-runtime.mjs",
    "build:dsh-launcher": "pnpm --filter @vectorai/dsh-launcher-macos build",
    "install:dsh-alpha": "./scripts/install-dsh-alpha-runtime.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:dsh-launcher": "pnpm --filter @vectorai/dsh-launcher-macos test",
    "e2e:host-owned-semantic-edit": "tsx scripts/e2e-host-owned-semantic-edit.ts",
    "e2e:motion-rig": "tsx scripts/e2e-temporary-motion-rig.ts",
    "e2e:drawing-surface": "tsx scripts/e2e-drawing-surface-contribution.ts",
    "e2e:dxf-smart-partition": "tsx scripts/e2e-dxf-smart-partition.ts",
    "e2e:tolerance-data-foundation": "tsx scripts/e2e-tolerance-data-foundation.ts",
    "e2e:golden-dimension-chain": "tsx scripts/e2e-golden-dimension-chain.ts",
    "test:cad-export": "vitest run packages/drawing-core/src/io/dxf*.test.ts packages/plugin-dsh-annotation-host/src/cad-*.test.ts packages/plugin-dsh-annotation-host/src/engineering-dxf-export.test.ts packages/plugin-dsh-annotation-host/src/golden-engineering-export.integration.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vectorai/drawing-core": "workspace:*",
    "@vectorai/drawing-edit-core": "workspace:*",
    "@vectorai/drawing-spatial": "workspace:*",
    "@vectorai/drawing-viewer-react": "workspace:*",
    "@vectorai/drawing-workspace": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-time": "0.1.2-rc.1",
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
