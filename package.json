{
  "name": "vectorai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dsh-space": "node scripts/build-dsh-space.mjs space",
    "build:dsh-annotation": "node scripts/build-dsh-space.mjs annotation",
    "build:dsh-launcher": "pnpm --filter @vectorai/dsh-launcher-macos build",
    "patch:dsh-workspace": "node scripts/dsh-inline-workspace-patch.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:dsh-launcher": "pnpm --filter @vectorai/dsh-launcher-macos test",
    "e2e:host-owned-semantic-edit": "tsx scripts/e2e-host-owned-semantic-edit.ts",
    "e2e:motion-rig": "tsx scripts/e2e-temporary-motion-rig.ts",
    "e2e:drawing-surface": "tsx scripts/e2e-drawing-surface-contribution.ts",
    "e2e:dxf-smart-partition": "tsx scripts/e2e-dxf-smart-partition.ts",
    "e2e:tolerance-data-foundation": "tsx scripts/e2e-tolerance-data-foundation.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vectorai/drawing-core": "workspace:*",
    "@vectorai/drawing-edit-core": "workspace:*",
    "@vectorai/drawing-spatial": "workspace:*",
    "@vectorai/drawing-viewer-react": "workspace:*",
    "@vectorai/drawing-workspace": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
